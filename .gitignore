# --- Large media belongs in Google Cloud Storage, not in git ---
# Raw gallery originals and source video must not be re-added (see REPO-01/REPO-02).
/assets/gallery/*.JPG
/assets/gallery/*.jpg
/assets/gallery/*.jpeg
/assets/gallery/*.png
/assets/gallery/*.MP4
/assets/gallery/*.mp4
/assets/gallery/*.MOV
/assets/gallery/*.mov
/assets/carousel/

# General video is ignored, except the compressed hero, which is a tracked live
# asset served locally.
*.mp4
*.MP4
*.mov
*.MOV
*.avi
*.mkv
!assets/videos/hero.mp4

